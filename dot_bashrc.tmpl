# 1-2 Rust / Cargo 国内镜像
export RUSTUP_DIST_SERVER="https://mirrors.ustc.edu.cn/rust-static"
export RUSTUP_UPDATE_ROOT="https://mirrors.ustc.edu.cn/rust-static/rustup"
export CARGO_REGISTRIES_CRATES_IO_INDEX="https://mirrors.ustc.edu.cn/crates.io-index"

# 1-3 PATH 扩展示例（可自行追加）
# export PATH="$HOME/.local/bin:$PATH"

# ---------------------------------------------------------
# 2. x-cmd 加载（仅当文件存在）
# ---------------------------------------------------------
# X_CMD="$HOME/.x-cmd.root/X"
# [[ -f $X_CMD ]] && source "$X_CMD"

# ---------------------------------------------------------
# 3. 终端行为 & 历史记录
# ---------------------------------------------------------
# 忽略重复命令、加大历史记录
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend              # 多会话实时追加历史
shopt -s checkwinsize            # 自动更新窗口大小

# ---------------------------------------------------------
# 4. 彩色与别名
# ---------------------------------------------------------
# # 4-1 颜色开关
# export LS_OPTIONS='--color=auto'
# [[ -x /usr/bin/dircolors ]] && eval "$(dircolors -b)"

# 4-2 常用别名
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias vi='vim'
alias c='clear'
alias ..='cd ..'
alias ...='cd ../..'

# ---------------------------------------------------------
# 5. 安全别名（防止误操作）
# ---------------------------------------------------------
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# ---------------------------------------------------------
# 6. 提示符（PS1）
# ---------------------------------------------------------
# 简洁彩色提示符：用户@主机:路径 $
PS1='\[\e[01;32m\]\u@\h\[\e[00m\]:\[\e[01;34m\]\w\[\e[00m\] \$ '

# ---------------------------------------------------------
# 7. 杂项
# ---------------------------------------------------------
# 7-1 让 less 支持颜色
export LESS='-R'

# 7-2 让 man 使用彩色高亮
export LESS_TERMCAP_mb=$'\e[01;31m'
export LESS_TERMCAP_md=$'\e[01;38;5;74m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[38;5;246m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[04;38;5;146m'

# 7-3 启用 bash-completion（若已安装）
# [[ -f /usr/share/bash-completion/bash_completion ]] && \
#     source /usr/share/bash-completion/bash_completion

# =============================================================================
#  END OF FILE
