# [ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X" # boot up x-cmd.

# 1. 让 ls 带颜色、带大小单位
alias ll='ls -alFh --color=auto --group-directories-first'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'

# 2. 更友好的 git log
alias gitlog="git log --graph --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all"

# 3. 代理自动切换（示例）
if ping -c 1 192.168.50.100 &>/dev/null; then
  export http_proxy=http://192.168.50.100:7890
  export https_proxy=$http_proxy
  echo "→ office proxy enabled"
else
  unset http_proxy https_proxy
fi

# 4. 让中文不乱码
export LANG=zh_CN.UTF-8
export LESSCHARSET=utf-8

# 5. 历史命令更丰富
export HISTCONTROL=ignoredups:erasedups
export HISTSIZE=10000
shopt -s histappend
PROMPT_COMMAND='history -a; history -c; history -r'

# 6. 提示符：当前目录 + git 分支
parse_git_branch() {
  git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}
PS1='\[\e[36m\]\W\[\e[32m\]$(parse_git_branch)\[\e[0m\] $ '

# 7. 自动补全增强
if [ -f /usr/share/bash-completion/bash_completion ]; then
  source /usr/share/bash-completion/bash_completion
fi

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path bash)"
{{ else }}#
# user-local binaries (uv tool shims, node/npm symlinks)
export PATH="$HOME/.local/bin:$PATH"
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
PS1='[\u@\h \W]\$ '

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Doom Emacs 便捷命令：dm
[ -f "$HOME/.config/shell/doom.sh" ] && . "$HOME/.config/shell/doom.sh"

[ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X" # boot up x-cmd.
