# ~/.bashrc — 由 chezmoi 渲染：Windows（Git Bash / MSYS2）与 WSL/Linux 共用一套
# 骨架，能力与 ~/.zshrc、~/.config/fish/config.fish 对齐：用户级 PATH、clang
# 工具链、历史与补全、yazi 的 cd 包装。

# ── PATH 清理：去重 + 丢弃已不存在的目录（保持首次出现顺序）──────────
# 为什么需要：pi、编辑器等工具会往 PATH 里 prepend 用户目录，其中常夹着已删
# 的残留（如 ~/.pi/agent/bin）。重复项拖慢命令查找，失效项让 PATH 难排查。
# 定义放在两条 OS 分支之前，两边共用；调用点在文件末尾。
_path_clean() {
  local out="" d
  while IFS= read -r d; do
    [ -n "$d" ] || continue          # 跳过空项（PATH 里的 :: 或首尾冒号）
    [ -d "$d" ] || continue          # 丢弃已不存在的目录
    case ":$out:" in *":$d:"*) continue ;; esac
    out="${out:+$out:}$d"
  done < <(printf '%s\n' "$PATH" | tr ':' '\n')
  PATH="$out"
  export PATH
}

{{ if eq .chezmoi.os "windows" }}
# ═══ Windows 侧（Git Bash / MSYS2）═══════════════════════════════════

# 用户级目录（与 zsh/fish 一致）；放在交互式判断之前，脚本里也能用
for _d in "$HOME/.local/bin" "$HOME/.bun/bin" "$HOME/.config/emacs/bin"; do
  [ -d "$_d" ] || continue
  case ":$PATH:" in *":$_d:"*) ;; *) PATH="$_d:$PATH" ;; esac
done
unset _d
export PATH

# clang/LLVM 工具链：构建脚本（make / CMake / configure）认这两个变量。
# 想临时改回 gcc：CC=gcc CXX=g++ make ...
if command -v clang >/dev/null 2>&1; then
  export CC=clang CXX=clang++
fi
if command -v llvm-config >/dev/null 2>&1; then
  export LLVM_CONFIG="$(command -v llvm-config)"
fi

# 非交互式（脚本、CI）到此为止：PATH / CC 已经就位
if [ -z "$BASH_VERSION" ] || [ -z "$PS1" ]; then
  return 0 2>/dev/null || exit 0
fi

# ── 环境变量 ─────────────────────────────────────────────────────────
: "${LANG:=zh_CN.UTF-8}"
export LANG
export LESSCHARSET=utf-8
export LESS='-R'
# Rust / Cargo 国内镜像
export RUSTUP_DIST_SERVER="https://mirrors.ustc.edu.cn/rust-static"
export RUSTUP_UPDATE_ROOT="https://mirrors.ustc.edu.cn/rust-static/rustup"
export CARGO_REGISTRIES_CRATES_IO_INDEX="https://mirrors.ustc.edu.cn/crates.io-index"

# ── 历史 ────────────────────────────────────────────────────────────
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend              # 多会话实时追加历史
shopt -s checkwinsize            # 自动更新窗口大小
# 追加而不是覆盖：覆盖式赋值会冲掉其它工具注册的 PROMPT_COMMAND
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# ── 别名：ls 系列走 eza（真 ls 用 \ls），其余与 zsh/fish 对齐 ─────────
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -la --icons --git --group-directories-first'
  alias la='eza -a --icons'
  alias lt='eza --tree --level=2 --icons'
else
  alias ls='ls --color=auto'
  alias ll='ls -alFh --color=auto --group-directories-first'
  alias la='ls -A --color=auto'
fi
alias grep='grep --color=auto'
alias vi='vim'
alias c='clear'
alias ..='cd ..'
alias ...='cd ../..'
alias gitlog="git log --graph --pretty=format:'%h %ad | %s%d [%an]' --abbrev-commit --all"
# 防误操作
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# ── 补全 ────────────────────────────────────────────────────────────
if [ -f /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
elif [ -f /etc/bash_completion ]; then
  . /etc/bash_completion
fi

# Kiro 终端集成：只在 kiro 的终端里加载，命令不存在时不报错
if [ "${TERM_PROGRAM:-}" = "kiro" ] && command -v kiro >/dev/null 2>&1; then
  . "$(kiro --locate-shell-integration-path bash)"
fi

# ── 提示符：当前目录 + git 分支 ──────────────────────────────────────
parse_git_branch() {
  git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}
PS1='\[\e[36m\]\W\[\e[32m\]$(parse_git_branch)\[\e[0m\] $ '

# ── 可选：办公网代理（默认关闭）────────────────────────────────────
# 以前每次开 shell 都 ping 一次，失败还会 unset 别处设好的代理：既拖慢启动，
# 又会把代理变量清掉。现在改成显式开启：OFFICE_PROXY=1 bash
if [ "${OFFICE_PROXY:-0}" = 1 ] && ping -n 1 -w 1000 192.168.50.100 >/dev/null 2>&1; then
  export http_proxy=http://192.168.50.100:7890
  export https_proxy="$http_proxy"
fi

{{ else }}
# ═══ WSL / Linux 侧 ══════════════════════════════════════════════════

# 用户级目录：uv tool 的 shim、bun、doom CLI
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$HOME/.config/emacs/bin:$PATH"

# clang/LLVM 工具链（同上）
if command -v clang >/dev/null 2>&1; then
  export CC=clang CXX=clang++
fi
if command -v llvm-config >/dev/null 2>&1; then
  export LLVM_CONFIG="$(command -v llvm-config)"
fi

# 非交互式（脚本、CI）到此为止
[[ $- != *i* ]] && return

# 别名：ls 走 eza（真 ls 用 \ls）
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -la --icons --git --group-directories-first'
  alias la='eza -a --icons'
  alias lt='eza --tree --level=2 --icons'
else
  alias ls='ls --color=auto'
fi
PS1='[\u@\h \W]\$ '

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# Doom Emacs 便捷命令：dm
[ -f "$HOME/.config/shell/doom.sh" ] && . "$HOME/.config/shell/doom.sh"
{{ end }}

# ── 共用尾巴：PATH 清理 / yazi 包装 / flyline ─────────────────────────
# 清掉工具插进来的重复与失效目录（函数定义在文件顶部）
_path_clean

# yazi：文件管理器；退出后 cd 到最后浏览的目录（官方 bash 包装）
# 用法：`y [路径]`
if command -v yazi >/dev/null 2>&1; then
  function y() {
    local tmp cwd
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")" || return 1
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
  }
fi

# flyline：Rust 实现的 readline 替代（Bash builtin），仅当 .so 存在时加载。
# 升级：重跑 cargo build --release，再把 target/release/libflyline.so 复制过来。
if [[ -f "$HOME/.local/lib/libflyline.so" ]]; then
  enable -f "$HOME/.local/lib/libflyline.so" flyline 2>/dev/null && \
    flyline mouse --mode disabled
fi
