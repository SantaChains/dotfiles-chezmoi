# chezmoi 忽略规则：这些源条目不会被应用到目标,也不会被 chezmoi 管理。
# 匹配的是源目录(本仓库)内的路径。

# chezmoi 自身状态数据库(本就该在目标端 ~/.config/chezmoi,绝不该进源/仓库)
chezmoistate.boltdb
**/*.boltdb
dot_config/chezmoi/chezmoistate.boltdb

# 仓库内部文档/备忘:仅存在于源仓库,不下发到 home
chezmoi.md
AGENTS.md

# 运行时状态类“伪配置”,不要当 dotfile 管理(会覆盖真实历史)
dot_viminfo
**/*.swp
**/.DS_Store

# 编辑器缓冲区/状态(非配置)
dot_config/micro/buffers
**/buffers

# lite-xl 运行时会话状态(每次启动会变,不管理)
dot_config/lite-xl/session.lua
dot_config/lite-xl/ws

# registry 凭据类文件,不被 chezmoi 下发
dot_config/pnpm/auth.ini
**/auth.ini

*.log
*.db

# 密钥/token 文件:绝不下发、绝不入库
**/gh/hosts.yml
dot_config/gh/hosts.yml
**/.netrc
**/credentials
**/id_rsa
**/id_ed25519

# 生成型缓存(即使被误收也不下发)
AppData/Local/clangd/index
AppData/Local/clangd/.history
**/clangd/index

# vim.pack 自动生成的 lockfile:每次插件变动会变,不进源仓库
dot_config/nvim/nvim-pack-lock.json
**/nvim-pack-lock.json


# 本地备份文件（*.bak-*）不进源/仓库
**/*.bak-*

# ─────────────────────────────────────────────────────────────
# OS 分支（2026-09-25）：同一仓库供 Windows + WSL 使用
# .chezmoi.os 取值：windows / linux / darwin
# ─────────────────────────────────────────────────────────────
# Windows 专属 → 在 Linux(WSL) 上忽略（不影响 Windows 行为）
{{- if eq .chezmoi.os "linux" }}
AppData
.glzr
.wslconfig
.emacs.d
.cargo
.config/lite-xl
.config/pragtical
.config/whkdrc
.config/lsd
.config/nvim
.bunrc
Mercurial.ini
banner
set-ripgrep-env.ps1
{{- end }}

# Linux/WSL 专属 → 在非 Linux 上忽略（不影响 Windows 现有受管项）
{{- if ne .chezmoi.os "linux" }}
.config/doom
.config/pip
.config/lsp-proxy
.config/shell
.bash_profile
.shinit
.bunfig.toml
.pi
.agents
{{- end }}

# 密钥（pi 凭据），全局忽略
**/auth.json
