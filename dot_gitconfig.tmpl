# ── delta (由 chezmoi 管理;lazygit 也已在用它,统一 diff 观感) ──
# 安装: scoop install delta   文档: https://github.com/dandavison/delta
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = false
	line-numbers = true
	side-by-side = false
	syntax-theme = Monokai Extended
	right-align-numbers = true
[diff]
	colorMoved = default
[merge]
	conflictStyle = zdiff3
[rerere]
	# 之前只配了 autoupdate/autoresolve，缺 enabled -> rerere 实际一直是关闭状态
	enabled = true
	autoupdate = true
	autoresolve = true

# ── 本次补充（每条都实测过依赖，勿随意删） ────────────────────────────
[init]
	defaultBranch = main

# rebase 拉取避免 merge commit；配套 pf = push --force-with-lease 使用。
# autoStash 必需：本仓库常有未同步漂移，脏工作区会让 rebase 直接中止。
[pull]
	rebase = true

[rebase]
	autostash = true

# 新分支首次 push 免 -u，否则 alias p/pf 会撞 "no upstream branch"
[push]
	autoSetupRemote = true

[alias]
	st = status
	cm = commit -m
	p = push
	pf = push --force-with-lease
	wa = worktree add
	wl = worktree list
	wd = worktree remove
	pretty = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
{{ else }}# WSL 侧 git 配置：主体 include Windows 上 chezmoi 管的那份，改一处两边生效
# （不能直接软链那份：里面有 schannel / delta 路径 / Windows 代理，Linux git 会报错）
[include]
	path = /mnt/c/Users/JliuPureey/.gitconfig

# ── 仅 WSL/Linux 的差异覆盖（必须在 include 之后才会生效）──
[http]
	sslBackend = openssl
	# schannel 是 Windows 专有后端，Linux git 只有 openssl/gnutls
	# proxy 沿用 Windows 配置（127.0.0.1:6857 从 WSL 可达）
	sslVerify = true
	# 原值 false 是为 Windows 侧代理/MITM 场景；WSL 直连可正常校验证书（下方实测通过）
{{ end }}